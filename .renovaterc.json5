{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#10.0.0"
  ],
  // Routine updates land Saturday morning, so a broken chart has the weekend
  // to be noticed rather than appearing mid-week.
  schedule: [
    "every weekend"
  ],
  // Talos 1.14 moved installer image production to the Image Factory.
  // ghcr.io/siderolabs/installer stops at v1.13.10 and gets no new tags, so the docker
  // datasource sees nothing newer and no PR is ever raised. Pointing it at the factory
  // instead does not work either: factory.talos.dev serves images but implements no
  // /v2/.../tags/list, so there is nothing for the docker datasource to enumerate.
  //
  // The factory publishes the versions it will actually build at /versions -- a bare JSON
  // array of tags -- which is the authoritative list for both talos/talenv.yaml and the
  // tuppr TalosUpgrade, since both end up requesting an image from this factory.
  customDatasources: {
    "talos-factory": {
      defaultRegistryUrlTemplate: "https://factory.talos.dev/versions",
      format: "json",
      transformTemplates: [
        '{"releases": [$.{"version": $}], "sourceUrl": "https://github.com/siderolabs/talos"}',
      ],
    },
  },
  // Two things in this repository pin a version that no built-in manager can
  // see. Each was drifting silently before these existed.
  customManagers: [
    {
      // CNPG puts the image on `spec.imageName`, which is a CRD field and not a
      // pod spec, so neither the kubernetes nor the flux manager looks at it.
      // Both VectorChord clusters sat on an 18.0 image for months because of it.
      customType: "regex",
      description: "CloudNativePG cluster images",
      managerFilePatterns: [
        "/^kubernetes/.+/cluster\\.ya?ml$/"
      ],
      matchStrings: [
        "imageName: (?<depName>\\S+):(?<currentValue>\\S+)"
      ],
      datasourceTemplate: "docker",
    },
    {
      // Trilium drives the Claude Code CLI as a subprocess and an init container
      // npm-installs it at pod start. No manager looks inside a shell command in
      // a HelmRelease value, so the pin would sit still while upstream moves --
      // and Trilium's own docs call out version skew between the two as the
      // thing that breaks this provider.
      customType: "regex",
      description: "npm packages installed by an init container",
      managerFilePatterns: [
        "/^kubernetes/.+\\.ya?ml$/"
      ],
      matchStrings: [
        "npm install -g .*?(?<depName>@[\\w.-]+/[\\w.-]+)@(?<currentValue>[\\w.+-]+)"
      ],
      datasourceTemplate: "npm",
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      "before 3am on the first day of the month"
    ],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  packageRules: [
    {
      // Rebuilt daily as <debian>-YYYYMMDD with no other version, so every
      // day is a "new release". Read the date as the version and take it
      // monthly: it is a cache proxy for CI, not something to chase.
      description: "apt-cacher-ng dated tags",
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "docker.io/mbentley/apt-cacher-ng"
      ],
      versioning: "regex:^(?<compatibility>[a-z]+)-(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$",
      schedule: [
        "before 6am on the first day of the month"
      ],
    },
    {
      description: "GitHub Actions Group",
      matchManagers: [
        "github-actions"
      ],
      groupName: "github-actions",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Mise Tools Group",
      matchManagers: [
        "mise"
      ],
      groupName: "mise tools",
      minimumReleaseAge: "3 days",
    },
    {
      // talenv.yaml and the tuppr TalosUpgrade carry the same annotation, so both files
      // move in one branch. semver rather than the custom datasource default so the
      // factory's -alpha entries are treated as unstable and skipped.
      description: "Talos",
      matchDatasources: [
        "custom.talos-factory"
      ],
      matchPackageNames: [
        "siderolabs/talos"
      ],
      versioning: "semver",
      groupName: "talos",
      semanticCommitScope: "talos",
      commitMessageTopic: "Talos",
      addLabels: [
        "renovate/talos"
      ],
      // A patch is a same-minor bugfix and can go in on its own; a minor is a
      // release to read the notes for. Separating them stops a 1.14.1 waiting
      // behind an unread 1.15.0.
      separateMinorPatch: true,
      prBodyNotes: [
        "⚠️ Merging this reboots all three nodes, one at a time, as soon as Flux applies the `TalosUpgrade`. tuppr goes to exactly this version and does **not** enforce Talos's supported upgrade path -- check that this is a single minor step from the running version.",
      ],
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "/flux-operator/",
        "/flux-instance/"
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // The kubernetes manager reports every `apiVersion` as a dependency.
      // Nothing here tracks cluster API deprecations that way, so they are only
      // noise in the extraction.
      description: "Ignore Kubernetes API versions",
      matchManagers: [
        "kubernetes"
      ],
      matchDatasources: [
        "kubernetes-api"
      ],
      enabled: false,
    },
    {
      // Both charts are released together and the GPU plugin's DaemonSet is
      // version-locked to the operator, so shipping them as two PRs means two
      // PRs that are only correct when merged together.
      description: "Intel Device Plugins Group",
      groupName: "intel-device-plugins",
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "/intel-device-plugins/"
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      // Every OCIRepository here is a Helm chart, but they resolve through the
      // docker datasource, so without this a chart bump reads "update image
      // ghcr.io/home-operations/charts/kromgo" and is labelled a container.
      description: "OCIRepository charts are charts, not images",
      matchDatasources: [
        "docker"
      ],
      matchFileNames: [
        "**/ocirepository.yaml"
      ],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
      addLabels: [
        "renovate/helm"
      ],
    },
    {
      // The tag is <postgres major>.<postgres minor>-<vectorchord>, which no
      // built-in versioning models: `docker` reads everything after the dash as
      // a compatibility suffix and would pin it forever, and `redhat` rejects
      // the value outright. `loose` compares the numbers left to right, which
      // is the right order here. allowedVersions keeps the floating short tags
      // (`18`, `18.4`) out of the candidate list -- taking one would silently
      // drop the extension version from the pin.
      description: "CloudNativePG images",
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/tensorchord/cloudnative-vectorchord"
      ],
      versioning: "loose",
      allowedVersions: "/^\\d+\\.\\d+-\\d+\\.\\d+\\.\\d+$/",
      prBodyNotes: [
        "⚠️ A VectorChord bump needs `ALTER EXTENSION vchord UPDATE` after the rolling restart; a PostgreSQL major needs a real CNPG major upgrade, not an image swap.",
      ],
    },
    {
      matchUpdateTypes: [
        "major"
      ],
      addLabels: [
        "type/major"
      ],
    },
    {
      matchUpdateTypes: [
        "minor"
      ],
      addLabels: [
        "type/minor"
      ],
    },
    {
      matchUpdateTypes: [
        "patch"
      ],
      addLabels: [
        "type/patch"
      ],
    },
    {
      matchUpdateTypes: [
        "digest"
      ],
      addLabels: [
        "type/digest"
      ],
    },
    {
      // Everything but the chart OCIRepositories, which are relabelled above.
      matchDatasources: [
        "docker"
      ],
      matchFileNames: [
        "!**/ocirepository.yaml"
      ],
      addLabels: [
        "renovate/container"
      ],
    },
    {
      description: "doco-cd managed compose stacks",
      matchManagers: [
        "docker-compose"
      ],
      addLabels: [
        "renovate/docker-compose"
      ],
      minimumReleaseAge: "3 days",
    },
    {
      matchDatasources: [
        "helm"
      ],
      addLabels: [
        "renovate/helm"
      ],
    },
    {
      matchManagers: [
        "github-actions"
      ],
      addLabels: [
        "renovate/github-action"
      ],
    },
    {
      matchDatasources: [
        "github-releases"
      ],
      addLabels: [
        "renovate/github-release"
      ],
    },
  ],
}