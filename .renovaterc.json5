{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#7.0.0"],
  // Routine updates land Saturday morning, so a broken chart has the weekend
  // to be noticed rather than appearing mid-week.
  schedule: ["every weekend"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["every weekend"],
  },
  packageRules: [
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      // Compose stacks under ./docker are deployed by doco-cd to the Oracle
      // host, not by Flux to the cluster. Renovate already finds them -- the
      // docker-compose manager's default pattern matches compose.yaml at any
      // depth -- so this only labels them, because merging one of these PRs
      // changes a different machine than every other container PR here.
      description: "doco-cd managed compose stacks",
      matchManagers: ["docker-compose"],
      addLabels: ["renovate/docker-compose"],
      // doco-cd polls every 5 minutes and redeploys on merge, unattended and
      // with nothing watching the result. A short soak means a tag that gets
      // pulled immediately after release has been out a few days first.
      minimumReleaseAge: "3 days",
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
