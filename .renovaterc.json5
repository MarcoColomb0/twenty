{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#7.0.0"],
  // Routine updates land Saturday morning, so a broken chart has the weekend
  // to be noticed rather than appearing mid-week.
  schedule: ["after 6am and before 11am on saturday"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["after 6am and before 11am on saturday"],
  },
  // Security fixes ignore the schedule entirely -- any day, any hour. The
  // global schedule above is a convenience, and waiting up to six days for a
  // known-vulnerable package is not a convenience worth having.
  //
  // Coverage caveat: this fires from GitHub's Dependabot alerts (and OSV
  // below), which cover package ecosystems and GitHub Actions. Neither
  // publishes advisories for container image tags or Helm charts, which is
  // most of this repository -- so in practice this path catches Actions, not
  // the apps. Container CVEs still arrive on the Saturday cadence.
  vulnerabilityAlerts: {
    enabled: true,
    schedule: ["at any time"],
    // No soak period on a security fix.
    minimumReleaseAge: null,
    addLabels: ["type/security"],
  },
  // Widens detection past GitHub's own alerts to the OSV database.
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
