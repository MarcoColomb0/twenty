// Tailnet policy for the twenty cluster.
//
// Paste into the Tailscale admin console under Access controls. It has to be
// applied BEFORE the operator first starts: the operator authenticates as
// tag:k8s-operator and cannot claim a tag the tailnet does not yet own.
//
// Tailscale cannot fetch this from a URL. A workflow that pushes it through
// the API on merge instead -- making the console downstream of this file --
// is proposed separately in .github/workflows/tailscale-acl.yaml.
//
// Contains no secrets. Ownership is expressed as autogroup:admin rather than an
// email address so this stays publishable.
{
	// The operator tags itself tag:k8s-operator and tags everything it creates
	// -- the subnet router pods included -- tag:k8s. That second tag is the
	// chart's proxyConfig.defaultTags default, inherited by the Connector.
	//
	// tag:k8s is owned by tag:k8s-operator, not by a person: it lets the
	// operator mint devices under that tag on its own, and stops anyone else
	// from claiming it.
	"tagOwners": {
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s":          ["tag:k8s-operator"],
	},

	// Without this, every subnet router replica needs its route approved by
	// hand in the Machines panel -- once per pod, again after every reschedule.
	// The Connector runs two replicas, so that is two clicks that recur.
	"autoApprovers": {
		"routes": {
			"192.168.100.0/24": ["tag:k8s"],
		},
	},

	// Personal tailnet: every member device reaches everything, including the
	// advertised LAN route. Narrow this if the tailnet ever gains a device that
	// should not see the cluster.
	"acls": [
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["*:*"],
		},
	],
}
